+#[test]
+fn opening_a_file_again_shows_its_new_version_at_once() {
+    // A mail program saves a newer attachment of the same name to the same path, then opens it.
+    // With the watcher out of the way (preference off), only the second open can show it.
+    let file = TempPdf::new("reopen", &fixture(2));
+    let mut h = harness(&file.path);
+    h.state_mut().reload_changed_files = false;
+    h.run_steps(1);
+    file.rebuild(&fixture(4));
+    h.state_mut().open_path(&file.path);
+    h.run_steps(2);
+    assert_eq!((h.state().views.len(), pages(&h)), (1, 4), "the new version, in the same tab");
+    assert!(!dirty(&h));
+}
+
+#[test]
+fn opening_a_file_again_keeps_unsaved_changes_and_offers_reload() {
+    let file = TempPdf::new("reopen-dirty", &fixture(2));
+    let mut h = harness(&file.path);
+    h.state_mut().reload_changed_files = false;
+    rotate_first_page(&mut h);
+    h.run_steps(1);
+    file.rebuild(&fixture(4));
+    h.state_mut().open_path(&file.path);
+    h.run_steps(2);
+    assert_eq!((pages(&h), dirty(&h)), (2, true), "not replaced behind the user's back");
+    h.get_by_label_contains("This file changed on disk");
+}

+    /// The file of tab `i` is opened again (from a mail program, the file manager, a link) while
+    /// its tab is open: show what is on disk now, not the version read earlier. A mail program
+    /// saves a newer attachment of the same name to the same path, and the watcher may not have
+    /// reloaded it (a dialog was open, or it had not looked yet). Opening again is the user
+    /// asking for the file, so this runs whatever the reload preference says. Unsaved changes
+    /// are kept and the Reload bar offered instead.
+    pub(crate) fn refresh_on_reopen(&mut self, i: usize) {
+        let Some(doc) = self.views.get(i).map(|v| v.id) else { return };
+        let Some(path) = self.session.get(doc).and_then(|d| d.path.clone()) else { return };
+        let stamp = Stamp::at(&path);
+        let Ok(bytes) = std::fs::read(&path) else { return };
+        if self.session.get(doc).is_some_and(|d| d.saved_bytes().as_slice() == bytes.as_slice()) {
+            return;
+        }
+        if self.has_unsaved_work(i) {
+            if let Some(view) = self.views.get_mut(i) {
+                view.disk_changed = true;
+            }
+            return;
+        }
+        self.watch.known_as(doc, stamp);
+        self.reload_view(i, Arc::new(bytes));
+    }
+
     /// Open `bytes` in place of tab `i`'s document, keeping the tab and the reader's place. A
     /// version that can't be opened leaves the document as it was, and says so.
     fn reload_view(&mut self, i: usize, bytes: Arc<Vec<u8>>) {
